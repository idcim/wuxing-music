# 复制为 .env 并填入真实值。docker compose 会自动读取同目录 .env。
# 完整部署与域名配置见 docs/DEPLOY.md。

# ── 运行模式 ──
# 生产必须 false：未配真实密钥（短信/支付/公众号）时后端「拒绝」而非「放行」。
# 开发/联调用 true：保留 dev 兜底（短信回传明文码、支付未配即免付开通、游客登录）。
DEBUG=false

# ── 外部 MySQL ──
# host.docker.internal = 宿主机（MySQL 装在跑 Docker 的同一台机器上时用）
# 1Panel 场景：换成 MySQL 的容器名（api 已接入 1panel-network）
DATABASE_URL=mysql+pymysql://用户名:密码@host.docker.internal:3306/wuxing?charset=utf8mb4
# 本地开发想用 SQLite 时改为：
# DATABASE_URL=sqlite:///./wuxing.db

# ── 安全 ──
# 必改！随机长串（如 openssl rand -hex 32）；DEBUG=false 时若仍为默认值后端拒绝启动
JWT_SECRET=请改成随机长字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码

# ── CORS（允许跨域访问后端的前端地址，JSON 数组）──
# H5 已容器内同源反代，无需 CORS；这里通常只需管理后台域名（若与 API 不同源）。
CORS_ORIGINS=["https://admin.your-domain.com"]

# ── 2.0：保持为空/false，完成准入与真单验收后再开启 ──
# 课件使用独立 private OSS 桶；不复用公开音乐桶。配置后台 CORS 直传域名。
COMMERCE_PRIVATE_ENDPOINT=
COMMERCE_PRIVATE_BUCKET=
COMMERCE_PRIVATE_KEY_ID=
COMMERCE_PRIVATE_KEY_SECRET=
# 正式 HTTPS API 域名，不带末尾 /；支付回调和私有售后图片链接使用。
COMMERCE_PUBLIC_BASE=
# 微信支付平台公钥 PEM（环境变量中保留换行）与公钥 ID，验证 APIv3 通知。
COMMERCE_WXPAY_PUBLIC_KEY=
COMMERCE_WXPAY_PUBLIC_KEY_ID=
COMMERCE_VIRTUAL_APPROVED=false
COMMERCE_VIRTUAL_IOS_APPROVED=false
COMMERCE_VIRTUAL_OFFER_ID=
COMMERCE_VIRTUAL_APP_KEY=
# 小程序数字支付加密消息推送配置（与普通微信支付 APIv3 不同）。
COMMERCE_PUSH_TOKEN=
COMMERCE_PUSH_AES_KEY=
COMMERCE_SHIPPING_APPROVED=false
# 第三方物流轨迹：服务端调用快递100，不依赖微信物流插件。账号需开通实时查询服务。
COMMERCE_LOGISTICS_PROVIDER=kuaidi100
COMMERCE_LOGISTICS_CUSTOMER=
COMMERCE_LOGISTICS_KEY=
# 非常用快递公司可补充“微信发货编码:快递100编码”的 JSON 映射。
COMMERCE_LOGISTICS_CARRIERS={}
# 私有售后凭证目录必须持久化，不能挂到公开 uploads。
COMMERCE_PRIVATE_DIR=private-commerce
