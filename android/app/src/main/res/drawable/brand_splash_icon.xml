<?xml version="1.0" encoding="utf-8"?>
<!-- 288dp 启动图标画布内保留 192dp 原图区域，原始品牌图片不做裁剪或重绘。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="192dp" android:height="192dp" android:gravity="center">
        <bitmap android:src="@drawable/brand_logo" android:gravity="fill" />
    </item>
</layer-list>
