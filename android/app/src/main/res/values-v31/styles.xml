<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 由系统启动层播放，旧系统保留完整静态 LOGO。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brandBlue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">@integer/brand_splash_duration_ms</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
